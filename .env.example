# Anthropic API key - required for real generation. Leave unset to run in MOCK_LLM mode.
ANTHROPIC_API_KEY=

# "anthropic" (real) or "mock" (deterministic offline stub, used in CI/dev)
LLM_PROVIDER=mock

# "sentence-transformer" (real embeddings, needs internet on first run) or "hashing" (offline fallback, deterministic)
EMBEDDING_PROVIDER=hashing

# Vector store persistence path
CHROMA_PERSIST_DIR=.chroma

# Retrieval tuning
TOP_K_DENSE=8
TOP_K_SPARSE=8
TOP_K_FINAL=5
RRF_K=10

# Guardrail: minimum fused retrieval score to attempt an answer instead of refusing
MIN_CONFIDENCE=0.05

# Prompt version pinned for this deployment
PROMPT_VERSION=v1
